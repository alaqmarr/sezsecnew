# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated prisma client (regenerated during setup via `npx prisma generate`)
/src/generated/

# misc & OS metadata
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# debug & runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# environment & secret files (keep .env.example tracked)
.env
.env.*
*.env
!.env.example
!.env.template

# vercel & deployment state
.vercel

# typescript & build caches
*.tsbuildinfo
next-env.d.ts

# local database, WAL/SHM journals, uploads, backups & data files (never commit)
/data/*
!/data/.gitkeep
/backups/
*.db
*.db-*
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-*
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
